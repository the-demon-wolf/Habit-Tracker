<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://android.com">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.6" android:thickness="5dp" android:useLevel="false">
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="-90" android:toDegrees="-90">
            <shape android:shape="ring" android:innerRadiusRatio="2.6" android:thickness="5dp" android:useLevel="true">
                <solid android:color="#6EE7B7" />
            </shape>
        </rotate>
    </item>
</layer-list>
